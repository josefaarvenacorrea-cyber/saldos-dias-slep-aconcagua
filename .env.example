# Conexión a Postgres (Neon). En Vercel la agrega sola la integración de Neon.
DATABASE_URL=

# Contraseña inicial de la cuenta de administración (mínimo 8 caracteres).
# Configúrala directamente en Vercel; al primer ingreso se pide cambiarla.
ADMIN_INITIAL_PASSWORD=

# Opcional: correo de la cuenta de administración.
ADMIN_EMAIL=administracion.personas@slepaconcagua.gob.cl

# Token con que los flujos de Power Automate consultan /api/integracion/documentos y descargan
# los PDF. Genera una cadena larga al azar y ponla igual en Vercel y en la conexión del flujo.
TOKEN_INTEGRACION=

# URL del webhook del flujo de Power Automate que archiva los PDF en el SharePoint, escribe las
# filas en las bases de Excel y manda los correos. Se obtiene al guardar el flujo por primera vez,
# en el paso "Cuando se recibe una solicitud HTTP". Sin esta variable la plataforma funciona igual,
# solo que no avisa a nadie.
POWER_AUTOMATE_WEBHOOK_URL=
